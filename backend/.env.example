# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/invento

# Security Config
SECRET_KEY=your-super-secret-key-change-it-in-production-123456
ACCESS_TOKEN_EXPIRE_MINUTES=60

# CORS Configuration
# Must be a JSON array of origins (e.g., ["http://localhost:3000", "https://invento.com"])
BACKEND_CORS_ORIGINS=["http://localhost:3000", "http://localhost:3001"]
